# Mercado Pago — access token
# -----------------------------------------------------------------------------
# Para modo test/sandbox: usá un token que empiece con "TEST-".
# Para producción: un token que empiece con "APP_USR-".
#
# Dónde obtenerlos:
#   https://www.mercadopago.com/developers/panel/credentials
#
# Reemplazá el valor de abajo por tu token. Mientras sea el placeholder,
# el endpoint /api/checkout va a devolver un 503 explicando este mismo mensaje.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx-reemplazar-por-tu-token-real

# URL pública del sitio (opcional)
# Se usa para armar las back_urls (success / pending / failure) que recibe
# Mercado Pago al terminar el checkout. Si la dejás vacía, el endpoint usa
# el origin de la request entrante (útil en desarrollo).
PUBLIC_SITE_URL=