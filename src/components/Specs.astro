---
import product from '../data/product.json';
---

<section id="detalles" class="relative w-full py-24 md:py-32 lg:py-40">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <div class="max-w-[65ch]" data-reveal>
      <p class="mb-6 inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.22em] text-copper">
        <span aria-hidden="true" class="block h-px w-8 bg-copper"></span>
        Capítulo 02 · La pieza
      </p>
      <h2 class="font-display text-[40px] font-light leading-[1.05] tracking-[-0.01em] md:text-[56px] md:leading-[1.02]">
        Cada detalle
        <span class="italic text-copper">está a la vista.</span>
      </h2>
      <p class="dropcap mt-6 text-[16px] leading-[1.7] text-ink-soft">
        Las medidas son las de una pieza real, no números redondos para quedar bien en la foto.
      </p>
    </div>

    <!-- Specs: 2-col card grid with asymmetric thin borders -->
    <ul class="mt-16 grid grid-cols-1 gap-4 md:mt-20 md:grid-cols-2 md:gap-5 lg:gap-6" data-reveal>
      {
        product.specs.map((spec, idx) => {
          // Alternate asymmetric corner radii across the grid.
          const radii = [
            'rounded-tl-[28px] rounded-tr-[6px] rounded-bl-[6px] rounded-br-[28px]',
            'rounded-tl-[6px] rounded-tr-[28px] rounded-bl-[28px] rounded-br-[6px]',
            'rounded-tl-[28px] rounded-tr-[6px] rounded-bl-[28px] rounded-br-[6px]',
            'rounded-tl-[6px] rounded-tr-[28px] rounded-bl-[6px] rounded-br-[28px]',
          ];
          return (
            <li
              class={`group asymmetric-frame bg-bone-100/60 p-7 transition-colors duration-500 hover:bg-bone-100 md:p-8 ${radii[idx % radii.length]}`}
            >
              <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-ink-mute">{spec.label}</p>
              <p class="mt-3 font-display text-[34px] font-light leading-[1.05] text-ink md:text-[40px]">{spec.value}</p>
              <p class="mt-3 text-[14px] leading-[1.6] text-ink-soft">{spec.detail}</p>
            </li>
          );
        })
      }
    </ul>

    <!-- Care instructions, separate block, no zigzag -->
    <div class="mt-20 md:mt-28" data-reveal>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4">
          <h3 class="font-display text-[28px] font-light leading-[1.15] md:text-[36px]">
            Cómo cuidarlo
          </h3>
          <span aria-hidden="true" class="mt-4 block h-px w-12 bg-copper"></span>
          <p class="mt-4 text-[14px] uppercase tracking-[0.18em] text-ink-mute">
            Pocos minutos, mucho tiempo de uso.
          </p>
        </div>
        <ol class="space-y-3 md:col-span-8 md:pt-2">
          {
            product.care.map((line, idx) => (
              <li class="flex gap-5 border border-bone-200 bg-bone px-5 py-4 rounded-tl-[18px] rounded-br-[18px]">
                <span class="font-display text-[18px] font-light text-copper">{String(idx + 1).padStart(2, '0')}</span>
                <span class="text-[15px] leading-[1.6] text-ink">{line}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>