---
import product from '../data/product.json';
---

<section id="detalles" class="relative w-full py-24 md:py-32 lg:py-40">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <div class="max-w-[65ch]" data-reveal>
      <h2 class="font-display text-[40px] font-light leading-[1.05] tracking-[-0.01em] md:text-[56px] md:leading-[1.02]">
        Cada detalle
        <span class="italic">está a la vista.</span>
      </h2>
      <p class="mt-5 text-[16px] leading-relaxed text-ink-soft">
        Las medidas son las de una pieza real, no números redondos para quedar bien en la foto.
      </p>
    </div>

    <!-- Specs: 2-col card grid -->
    <ul class="mt-16 grid grid-cols-1 gap-3 md:mt-20 md:grid-cols-2 md:gap-4 lg:gap-5" data-reveal>
      {
        product.specs.map((spec) => (
          <li class="group rounded-[20px] bg-bone-100/70 p-7 ring-1 ring-bone-200 transition-colors duration-500 hover:bg-bone-100 md:p-8">
            <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-ink-soft">{spec.label}</p>
            <p class="mt-3 font-display text-[34px] font-light leading-[1.05] text-ink md:text-[40px]">{spec.value}</p>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{spec.detail}</p>
          </li>
        ))
      }
    </ul>

    <!-- Care instructions, separate block, no zigzag -->
    <div class="mt-20 md:mt-28" data-reveal>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4">
          <h3 class="font-display text-[28px] font-light leading-[1.1] md:text-[36px]">
            Cómo cuidarlo
          </h3>
          <p class="mt-3 text-[14px] uppercase tracking-[0.18em] text-ink-soft">
            Pocos minutos, mucho tiempo de uso.
          </p>
        </div>
        <ol class="space-y-3 md:col-span-8 md:pt-2">
          {
            product.care.map((line, idx) => (
              <li class="flex gap-5 rounded-2xl border border-bone-200 bg-bone-50 px-5 py-4">
                <span class="font-display text-[18px] font-light text-forest-700">{String(idx + 1).padStart(2, '0')}</span>
                <span class="text-[15px] leading-relaxed text-ink">{line}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>