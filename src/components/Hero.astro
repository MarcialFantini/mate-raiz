---
---

<section class="relative w-full pt-10 pb-16 md:pt-16 md:pb-24 lg:pt-20 lg:pb-32">
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-10 px-5 md:grid-cols-12 md:gap-8 md:px-10 lg:gap-12">
    <!-- Left column: copy -->
    <div class="flex flex-col justify-center md:col-span-7 lg:col-span-6" data-reveal>
      <p class="mb-6 inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.22em] text-forest-700">
        <span aria-hidden="true" class="h-px w-8 bg-forest-700/60"></span>
        Edición limitada
      </p>

      <h1 class="font-display text-[44px] font-light leading-[1.02] tracking-[-0.01em] text-ink md:text-[64px] md:leading-[0.98] lg:text-[78px]">
        Una pieza,
        <span class="italic">un ritual.</span>
      </h1>

      <p class="mt-6 max-w-[44ch] text-[17px] leading-relaxed text-ink-soft md:text-[18px]">
        Mate imperial torneado a mano, con virola de alpaca. Para las cebadas que importan.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#comprar"
          class="cta-push inline-flex items-center gap-3 rounded-full bg-forest-900 px-7 py-3.5 text-[14px] font-medium tracking-wide text-bone-50 hover:bg-forest-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest-900"
        >
          Comprar ahora
          <span aria-hidden="true" class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-bone-50/15 text-[12px] leading-none">↗</span>
        </a>
        <a
          href="#historia"
          class="group inline-flex items-center gap-2 text-[14px] font-medium tracking-wide text-ink underline decoration-bone-300 decoration-1 underline-offset-[6px] transition-colors duration-300 hover:text-forest-700 hover:decoration-forest-700"
        >
          Conocer el oficio
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>

      </div>

    <!-- Right column: image -->
    <div class="relative md:col-span-5 lg:col-span-6" data-reveal>
      <div class="relative overflow-hidden rounded-[28px] bg-bone-100 ring-1 ring-bone-200 shadow-[0_30px_80px_-30px_rgba(17,36,26,0.35)]">
        <img
          src="https://picsum.photos/seed/mate-raiz-imperial-virola/1200/1400"
          alt="Mate imperial de algarrobo con virola de alpaca, apoyado sobre un fondo oscuro"
          width="1200"
          height="1400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="editorial-img aspect-[6/7] h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>