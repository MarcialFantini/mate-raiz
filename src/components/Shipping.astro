---
import shipping from '../data/shipping.json';
---

<section id="envio" class="relative w-full py-24 md:py-32 lg:py-40">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <div class="max-w-[65ch]" data-reveal>
      <p class="mb-6 inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.22em] text-copper">
        <span aria-hidden="true" class="block h-px w-8 bg-copper"></span>
        Capítulo 06 · Después de la compra
      </p>
      <h2 class="font-display text-[40px] font-light leading-[1.05] tracking-[-0.01em] md:text-[56px] md:leading-[1.02]">
        {shipping.shipping.title}
        <span class="block italic text-copper">y devoluciones.</span>
      </h2>
      <p class="dropcap mt-6 text-[16px] leading-[1.7] text-ink-soft">
        {shipping.shipping.intro}
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-4 md:mt-16 md:grid-cols-3" data-reveal>
      {
        shipping.shipping.options.map((opt, idx) => {
          const radii = [
            'rounded-tl-[22px] rounded-tr-[6px] rounded-bl-[6px] rounded-br-[22px]',
            'rounded-tl-[6px] rounded-tr-[22px] rounded-bl-[22px] rounded-br-[6px]',
            'rounded-tl-[22px] rounded-tr-[6px] rounded-bl-[22px] rounded-br-[6px]',
          ];
          return (
            <li class={`asymmetric-frame bg-bone-100/60 p-5 ${radii[idx % radii.length]}`}>
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-[13px] font-medium uppercase tracking-[0.18em] text-ink-mute">{opt.label}</p>
                <p class="font-display text-[16px] italic text-copper">{opt.value}</p>
              </div>
              <p class="mt-2 text-[13px] leading-[1.6] text-ink-soft">{opt.detail}</p>
            </li>
          );
        })
      }
    </ul>

    <p class="mt-8 text-[14px] leading-[1.6] text-ink-soft" data-reveal>
      {shipping.shipping.cost}
    </p>

    <!-- Returns block: different layout to avoid zigzag -->
    <div class="mt-24 grid grid-cols-1 gap-10 border-t border-bone-200 pt-16 md:mt-32 md:grid-cols-12 md:gap-10" data-reveal>
      <div class="md:col-span-4">
        <h3 class="font-display text-[28px] font-light leading-[1.15] md:text-[36px]">
          {shipping.returns.title}
        </h3>
        <span aria-hidden="true" class="mt-4 block h-px w-12 bg-copper"></span>
      </div>
      <div class="md:col-span-8">
        <p class="dropcap max-w-[60ch] text-[16px] leading-[1.7] text-ink-soft">{shipping.returns.intro}</p>
        <ol class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
          {
            shipping.returns.policy.map((line, idx) => (
              <li class="flex gap-4 border border-bone-200 bg-bone-100/50 p-5 rounded-tl-[18px] rounded-br-[18px]">
                <span class="font-display text-[18px] font-light text-copper">{String(idx + 1).padStart(2, '0')}</span>
                <span class="text-[14px] leading-[1.6] text-ink">{line}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>