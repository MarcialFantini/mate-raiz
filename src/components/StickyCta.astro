---
/**
 * CTA sticky que aparece en mobile / tablet cuando el usuario hace scroll
 * en páginas largas (catálogo, blog, etc.). En desktop el CTA principal ya
 * está en la nav, así que se oculta a partir de `lg:`.
 */
interface Props {
  productName: string;
  productSlug: string;
  priceLabel: string;
}
const { productName, productSlug, priceLabel } = Astro.props;
---

<aside
  class="fixed inset-x-0 bottom-0 z-40 border-t border-bone-200 bg-bone/95 px-5 py-3 backdrop-blur-md lg:hidden"
  data-sticky-cta
  aria-label="Compra rápida"
>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="truncate text-[13px] font-medium text-ink">{productName}</p>
      <p class="text-[12px] uppercase tracking-[0.16em] text-ink-mute">{priceLabel}</p>
    </div>
    <a
      href={`/producto/${productSlug}#comprar`}
      class="cta-push inline-flex shrink-0 items-center gap-2 rounded-full bg-forest-700 px-5 py-2.5 text-[13px] font-medium tracking-wide text-bone hover:bg-forest-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest-700"
    >
      Comprar
      <span aria-hidden="true" class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-bone/20 text-[11px] leading-none">↗</span>
    </a>
  </div>
</aside>
