---
import product from '../data/product.json';
---

<section id="historia" class="relative w-full bg-forest-900 py-24 text-bone md:py-32 lg:py-40">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <!-- Section header -->
    <div class="max-w-[65ch]" data-reveal>
      <p class="mb-6 inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.22em] text-copper-soft">
        <span aria-hidden="true" class="block h-px w-8 bg-copper"></span>
        Capítulo 01 · El taller
      </p>
      <h2 class="font-display text-[40px] font-light leading-[1.05] tracking-[-0.01em] md:text-[56px] md:leading-[1.02]">
        El oficio
        <span class="block italic text-copper-soft">se hace lento.</span>
      </h2>
      <p class="dropcap mt-6 text-[16px] leading-[1.7] text-bone/85">
        Cada mate lleva meses de trabajo antes de llegar a tu mano. La madera se elige, se cura, se tornea y se termina sin atajos.
      </p>
    </div>

    <!-- Asymmetric block: maker photo + bio -->
    <div class="mt-20 grid grid-cols-1 gap-8 md:mt-28 md:grid-cols-12 md:gap-10" data-reveal>
      <div class="md:col-span-5 lg:col-span-5">
        <!-- Asymmetric thin frame on dark section (hairline bone, copper top) -->
        <div class="overflow-hidden asymmetric-frame rounded-tl-[32px] rounded-tr-[6px] rounded-bl-[6px] rounded-br-[32px]">
          <img
            src="https://picsum.photos/seed/mate-raiz-taller-alfarero/900/1100"
            alt="Manos del artesano torneando un mate sobre el torno en el taller de Sierras de Córdoba"
            width="900"
            height="1100"
            loading="lazy"
            decoding="async"
            class="editorial-img aspect-[9/11] h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="flex flex-col justify-center md:col-span-6 md:col-start-7 lg:col-span-6 lg:col-start-8">
        <h3 class="font-display text-[28px] font-light leading-[1.15] md:text-[36px]">
          {product.maker.name}
        </h3>
        <p class="mt-3 text-[13px] uppercase tracking-[0.18em] text-bone/55">
          {product.maker.location} · desde {product.maker.since}
        </p>
        <p class="dropcap-light mt-6 max-w-[44ch] text-[16px] leading-[1.7] text-bone/80">
          {product.maker.story}
        </p>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-20 md:my-28" data-reveal>
      <div class="flex items-center gap-4">
        <span class="h-px flex-1 bg-bone/15"></span>
        <span class="font-display italic text-copper">el proceso</span>
        <span class="h-px flex-1 bg-bone/15"></span>
      </div>
    </div>

    <!-- Process timeline: 6 steps, no images, vertical numbered -->
    <ol class="grid grid-cols-1 gap-px overflow-hidden border border-bone/10 bg-bone/5 md:grid-cols-2 lg:grid-cols-3 rounded-tl-[24px] rounded-br-[24px]" data-reveal>
      {
        product.process.map((step, idx) => (
          <li class="bg-forest-900 p-7 md:p-8">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-display text-[34px] font-light text-copper-soft/90">{String(step.step).padStart(2, '0')}</span>
              {idx === 0 ? <span aria-hidden="true" class="block h-px flex-1 bg-copper/40"></span> : null}
            </div>
            <h4 class="mt-3 font-display text-[22px] font-medium leading-tight">{step.title}</h4>
            <p class="mt-3 text-[14px] leading-[1.6] text-bone/75">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <!-- Full-width workshop image -->
    <div class="mt-20 md:mt-28" data-reveal>
      <div class="overflow-hidden asymmetric-frame rounded-tl-[6px] rounded-tr-[28px] rounded-bl-[28px] rounded-br-[6px]">
        <img
          src="https://picsum.photos/seed/mate-raiz-galpon-cordoba/1800/900"
          alt="Galpón del taller en las Sierras de Córdoba con bloques de algarrobo apilados esperando curado"
          width="1800"
          height="900"
          loading="lazy"
          decoding="async"
          class="editorial-img aspect-[2/1] h-full w-full object-cover"
        />
      </div>
      <p class="mt-3 text-right text-[12px] uppercase tracking-[0.18em] text-bone/50">
        El galpón · Sierras de Córdoba
      </p>
    </div>
  </div>
</section>