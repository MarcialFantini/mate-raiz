---
import product from '../data/product.json';
---

<section id="historia" class="relative w-full bg-forest-950 py-24 text-bone-50 md:py-32 lg:py-40">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <!-- Section header -->
    <div class="max-w-[65ch]" data-reveal>
      <h2 class="font-display text-[40px] font-light leading-[1.05] tracking-[-0.01em] md:text-[56px] md:leading-[1.02]">
        El oficio
        <span class="block italic text-amber-soft">se hace lento.</span>
      </h2>
      <p class="mt-5 text-[16px] leading-relaxed text-bone-200/85">
        Cada mate lleva meses de trabajo antes de llegar a tu mano. La madera se elige, se cura, se tornea y se termina sin atajos.
      </p>
    </div>

    <!-- Asymmetric block: maker photo + bio -->
    <div class="mt-20 grid grid-cols-1 gap-8 md:mt-28 md:grid-cols-12 md:gap-10" data-reveal>
      <div class="md:col-span-5 lg:col-span-5">
        <div class="overflow-hidden rounded-[24px] ring-1 ring-bone-50/10">
          <img
            src="https://picsum.photos/seed/mate-raiz-taller-alfarero/900/1100"
            alt="Manos del artesano torneando un mate sobre el torno en el taller de Sierras de Córdoba"
            width="900"
            height="1100"
            loading="lazy"
            decoding="async"
            class="editorial-img aspect-[9/11] h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="flex flex-col justify-center md:col-span-6 md:col-start-7 lg:col-span-6 lg:col-start-8">
        <h3 class="font-display text-[28px] font-light leading-[1.1] md:text-[36px]">
          {product.maker.name}
        </h3>
        <p class="mt-2 text-[13px] uppercase tracking-[0.18em] text-bone-200/60">
          {product.maker.location} · desde {product.maker.since}
        </p>
        <p class="mt-5 max-w-[44ch] text-[16px] leading-relaxed text-bone-200/80">
          {product.maker.story}
        </p>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-20 md:my-28" data-reveal>
      <div class="flex items-center gap-4">
        <span class="h-px flex-1 bg-bone-50/15"></span>
        <span class="h-px flex-1 bg-bone-50/15"></span>
      </div>
    </div>

    <!-- Process timeline: 6 steps, no images, vertical numbered -->
    <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-[20px] border border-bone-50/10 bg-bone-50/5 md:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        product.process.map((step) => (
          <li class="bg-forest-950 p-7 md:p-8">
            <span class="font-display text-[34px] font-light text-amber-soft/80">{String(step.step).padStart(2, '0')}</span>
            <h4 class="mt-3 font-display text-[22px] font-medium leading-tight">{step.title}</h4>
            <p class="mt-3 text-[14px] leading-relaxed text-bone-200/75">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <!-- Full-width workshop image -->
    <div class="mt-20 md:mt-28" data-reveal>
      <div class="overflow-hidden rounded-[24px] ring-1 ring-bone-50/10">
        <img
          src="https://picsum.photos/seed/mate-raiz-galpon-cordoba/1800/900"
          alt="Galpón del taller en las Sierras de Córdoba con bloques de algarrobo apilados esperando curado"
          width="1800"
          height="900"
          loading="lazy"
          decoding="async"
          class="editorial-img aspect-[2/1] h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>